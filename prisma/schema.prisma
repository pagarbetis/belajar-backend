generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  CASHIER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
  E_WALLET
}

model User {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar(120)
  email        String     @unique @db.VarChar(150)
  passwordHash String     @db.VarChar(255)
  role         UserRole   @default(CASHIER)
  status       UserStatus @default(ACTIVE)
  orders       Order[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("users")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(100)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id          Int         @id @default(autoincrement())
  nama        String      @db.VarChar(150)
  category_id Int
  category    Category    @relation(fields: [category_id], references: [id], onDelete: Restrict)
  price       Decimal     @db.Decimal(12, 2)
  stock       Int         @default(0)
  description String?     @db.Text
  is_active   Boolean     @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([category_id])
  @@map("products")
}

model Order {
  id            Int           @id @default(autoincrement())
  orderNumber   String        @unique @db.VarChar(50)
  userId        Int?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod @default(CASH)
  status        OrderStatus   @default(PENDING)
  totalAmount   Decimal       @db.Decimal(12, 2)
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model StoreSetting {
  id         Int      @id @default(autoincrement())
  storeName  String   @db.VarChar(150)
  tagline    String?  @db.VarChar(150)
  taxPercent Decimal  @default(0) @db.Decimal(5, 2)
  address    String?  @db.Text
  updatedAt  DateTime @updatedAt

  @@map("store_settings")
}